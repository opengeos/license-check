#!/usr/bin/env -S python3 -I
"""Run olc from a checkout under `python3 -I`, which ignores PYTHONPATH and the working
directory: this adds only the checkout itself to sys.path."""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from olc.cli import main  # noqa: E402

sys.exit(main())
